# =========================================
# APPLICATION RUNTIME ENVIRONMENT VARIABLES
# (Required to run Flask app / Docker container locally)
# =========================================
FLASK_APP=app.py
FLASK_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/flask_db

# =========================================
# GITHUB ACTIONS CI/CD SECRETS REFERENCE
# (Configure these in GitHub Repo -> Settings -> Secrets and variables -> Actions)
# =========================================

# Database Configuration
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/flask_db?retryWrites=true&w=majority

# AWS & ECR Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_if_using_academy
AWS_REGION=us-east-1
ECR_REPOSITORY=flaskapp

# EC2 SSH Deployment Configuration
EC2_HOST=your_ec2_public_ip
EC2_USERNAME=ubuntu
EC2_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----\n..."

# Email Notification Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
NOTIFICATION_EMAIL=recipient_email@gmail.com

# =========================================